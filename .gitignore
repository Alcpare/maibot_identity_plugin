# 运行时生成的用户配置（含个人隐私，绝不能进仓库）
/config.toml

# 配置备份目录（含历史名单，同样含隐私）
/config_back/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 插件运行期数据（正常在 data/plugins/<id>/，这里只是防御性排除）
speakers.json
identity_ui.json
identity_stats.json
portraits/
*.log

# 临时/验收脚本与备份
/_manifest.json.bak_*
/tests/_acceptance_*.py
/tests/_diag_*.py
/tests/_verify_*.py

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
