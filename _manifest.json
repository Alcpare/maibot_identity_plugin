{
  "manifest_version": 2,
  "version": "2.0.0",
  "name": "身份认知",
  "description": "让她知道当前对话者是谁（主人 / 朋友 / 群友），从而用对态度。支持自定义身份档位与独立提示词，还可以上传 AI 画像让她记住自己的样子。纯手动白名单，不调用 LLM、不写宿主数据库；QQ 号只用于内部识别，永不进入提示词。",
  "author": {
    "name": "Alcpare",
    "url": "https://github.com/Alcpare"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Alcpare/maibot_identity_plugin",
    "homepage": "https://github.com/Alcpare/maibot_identity_plugin",
    "issues": "https://github.com/Alcpare/maibot_identity_plugin/issues"
  },
  "changelog": "README.md",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.22.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "webui.claim_upload",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "Alcpare.identity"
}
